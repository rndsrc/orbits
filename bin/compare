[ "$#" -ge 1 ] && i="$1" || i="tests/circle"

echo haha

n=$(expr $(cat $i | wc -l) - 1)
echo "Comparing $n-body problem: $i"

make

for s in Euler DK KD KDK DKD ChinC; do
    time bin/simulate "$i" "$s" "$s"
done
