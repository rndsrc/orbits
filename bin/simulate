[ "$#" -ge 1 ] && i="$1" || i="tests/circle"
[ "$#" -ge 2 ] && o="$2" || o="out"
[ "$#" -ge 3 ] && s="$3" || s="ChinC"
[ "$#" -ge 4 ] && echo "usage: $0 INPUT [OUTPUT [SCHEME]]" && exit

m=$(cat $i | wc -l)
n=$(expr $m - 1)

echo "$n" > "$o.dat"                                        # n-body
cat "$i" | awk "{if (count++%${m}) print \$0;}" >> "$o.dat" # initial
"bin/$s" 2> "$o.eng" < $i \
	 | awk "{if (count++%${m}) print \$0;}" >> "$o.dat" # outputs
